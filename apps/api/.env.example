PORT=3001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/tutor
WEB_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

